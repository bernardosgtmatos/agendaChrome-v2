PORT=5000
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.onrender.com
DEV_URL=http://localhost:5173

# Neon Postgres (Render). Se vazio, usa SQLite local (dev).
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

JWT_SECRET=troque-por-um-segredo-forte
CRON_SECRET=troque-por-um-segredo-de-cron

# Use EMAIL_DEV_MODE=true para exibir o código no terminal.
# Para envio real, preencha SMTP_USER, SMTP_PASS e SMTP_FROM e use EMAIL_DEV_MODE=false.
EMAIL_DEV_MODE=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
